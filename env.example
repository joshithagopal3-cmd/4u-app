# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/4u-app
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/4u-app

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Coding Platform APIs (optional - app uses mock data if not provided)
LEETCODE_API_URL=https://leetcode-stats-api.herokuapp.com
CODECHEF_API_URL=https://codechef-api.vercel.app

# Points Config
POINTS_EVENT_ATTEND=50
POINTS_EVENT_ORGANIZE=100
POINTS_CODING_PROBLEM=10
POINTS_CONTEST_PARTICIPATE=30
